<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Alarm-Web | Manage</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@1/css/pico.min.css">
    <style>
        /* Small styling for action buttons to sit side-by-side */
        .action-buttons { display: flex; gap: 0.5rem; }
        .action-buttons form { margin: 0; }
        .action-buttons button { padding: 0.25rem 0.5rem; font-size: 0.8rem; }
    </style>
</head>
<body>
    <main class="container">
        <%- include('partials/navbar') %>

        <% if (message) { %>
            <article style="background-color: #d1e7dd; color: #0f5132; border-color: #badbcc; padding: 1rem; margin-bottom: 2rem; border-radius: 5px;">
                <strong>Notice:</strong> <%= message %>
            </article>
        <% } %>

        <h2><%= editAlarm ? 'Edit Alarm' : 'Add New Alarm' %></h2>
        
        <form action="<%= editAlarm ? '/edit-alarm/' + editAlarm.id : '/add-alarm' %>" method="POST">
            <div class="grid">
                <label>
                    Title
                    <input type="text" name="title" placeholder="e.g., Morning Run" value="<%= editAlarm ? editAlarm.title : '' %>" required>
                </label>
                <label>
                    Date
                    <input type="date" name="date" value="<%= editAlarm ? editAlarm.date : '' %>" required>
                </label>
                <label>
                    Time
                    <input type="time" name="time" value="<%= editAlarm ? editAlarm.time : '' %>" required>
                </label>
            </div>
            <label>
                Description
                <textarea name="description" placeholder="Any specific tasks or notes?"><%= editAlarm ? editAlarm.description : '' %></textarea>
            </label>
            
            <div class="grid">
                <button type="submit"><%= editAlarm ? 'Update Alarm' : 'Save Alarm' %></button>
                <% if (editAlarm) { %>
                    <a href="/manage" role="button" class="secondary outline">Cancel Edit</a>
                <% } %>
            </div>
        </form>

        <hr>

        <h2>All Alarms</h2>
        <% if (alarms.length === 0) { %>
            <p>Your alarm list is empty.</p>
        <% } else { %>
            <figure>
                <table role="grid">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Date</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% alarms.forEach(alarm => { %>
                            <tr>
                                <td><strong><%= alarm.time %></strong></td>
                                <td><%= alarm.date %></td>
                                <td><%= alarm.title %></td>
                                <td><%= alarm.isActive ? '🟢 Active' : '⚪ Off' %></td>
                                <td>
                                    <div class="action-buttons">
                                        <a href="/manage?edit=<%= alarm.id %>" role="button" class="secondary">Edit</a>
                                        
                                        <form action="/delete-alarm/<%= alarm.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this alarm?');">
                                            <button type="submit" style="background-color: #d9534f; border-color: #d43f3a;">Delete</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </figure>
        <% } %>
    </main>
</body>
</html>